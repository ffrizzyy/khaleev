# Khaleev backend configuration.
#
# Copy this file to `.env` to override defaults. Every setting has a working
# local default, so Khaleev runs fully with zero API keys: Ollama is the default
# local generator and embeddings run locally. Values below are the defaults.
# Directory settings are derived from KHALEEV_DATA_DIR; see the end of the file.

# Local data directory: SQLite metadata, PDF originals, vector index, golden sets.
# Default: <repo>/data (backend/src/khaleev/paths.py)
KHALEEV_DATA_DIR=./data

# Local embedding model (downloaded once, explicitly; tests never download models).
# Default: all-MiniLM-L6-v2
KHALEEV_EMBEDDER_ID=all-MiniLM-L6-v2

# Answer generator: "ollama" (default, local, no key) or "cloud" (needs a key).
# Default: ollama
KHALEEV_GENERATOR=ollama
# Default: http://localhost:11434
KHALEEV_OLLAMA_BASE_URL=http://localhost:11434
# Default: llama3.1:8b
KHALEEV_OLLAMA_MODEL=llama3.1:8b

# Optional cloud generator. Leave blank for zero-key local operation.
# Default: unset (no cloud key, no cloud model)
KHALEEV_CLOUD_API_KEY=
KHALEEV_CLOUD_MODEL=

# Retrieval and chunking.
# Default: 5 (top-k chunks per question; recorded with every eval run)
KHALEEV_RETRIEVAL_K=5
# Default: 52428800 (50 MB; larger PDF uploads are rejected with HTTP 413 before ingest)
KHALEEV_MAX_UPLOAD_BYTES=52428800
# Default: 600 (must be within 400-800 characters)
KHALEEV_CHUNK_SIZE=600
# Default: 0.12 (must be within 0.10-0.15, i.e. 10%-15% overlap)
KHALEEV_CHUNK_OVERLAP_RATIO=0.12

# Derived directories (not configurable, created by Settings.ensure_data_dir()):
#   <KHALEEV_DATA_DIR>/pdfs    uploaded PDF originals
#   <KHALEEV_DATA_DIR>/index   per-document vector index files
#   <KHALEEV_DATA_DIR>/golden  per-document golden-set JSON files (Settings.golden_dir)
